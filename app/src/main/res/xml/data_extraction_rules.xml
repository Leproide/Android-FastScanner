<?xml version="1.0" encoding="utf-8"?>
<!--
  FastScanner - backup / device-transfer rules (Android 12+)
  Copyright (C) 2026 - License: GPL-3.0
  Author: https://github.com/Leproide

  Nothing is exported: settings contain credentials (Keystore-encrypted, useless
  on another device) and pending folders may contain scanned documents.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
